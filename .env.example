# OceanTrace — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# Anything set here can also be set later from the Key Management page, which
# stores credentials encrypted in the database and takes precedence over this
# file (so an operator can rotate a key without a redeploy).
#
# Verify everything at once with:
#     cd 1_indhu_main_system
#     ../.venv/Scripts/python -m backend.verify_credentials

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ---------------------------------------------------------------------------
# Security  — SET THESE TWO FIRST
# ---------------------------------------------------------------------------
# Encrypts stored credentials at rest. Without it the key store still works but
# saves values unencrypted and says so on the Key Management page.
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Bearer token for the admin key-management routes (X-Admin-Token header).
# If unset, a fresh one is generated per process and printed at startup.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# 1. Sentinel-1 scenes                                        (owner: Pavitra)
#    Primary: Copernicus Data Space Ecosystem (CDSE), OData catalogue.
#
#    THE SIMPLE PATH -- this is all you need:
#      1. https://dataspace.copernicus.eu -> Register (free, instant, email
#         confirmation). Choose the plain "Copernicus Data Space Ecosystem"
#         account, NOT a federated/EU-Login/institutional sign-in -- the token
#         endpoint below only accepts a native CDSE password.
#      2. Put that same email + password here. Done. No OAuth client, no
#         API key to generate.
#
#    The service exchanges these for a bearer token via the public
#    `cdse-public` client (grant_type=password). The token lives ~10 minutes;
#    the token-refresh wrapper renews it mid-download, which is why a 4 GB
#    scene does not die at minute 10 with a misleading 401.
CDSE_USERNAME=
CDSE_PASSWORD=

#    OPTIONAL, and only if you also want Sentinel Hub processing APIs:
#      Profile -> Sharing / OAuth clients -> create client
#    Leave blank otherwise; username/password above is the supported path.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

#    Fallback: ASF Vertex, which uses a NASA Earthdata login
#    Sign up: https://urs.earthdata.nasa.gov  ->  register (free, instant)
EARTHDATA_USER=
EARTHDATA_PASS=

# ---------------------------------------------------------------------------
# 2. Ocean currents                                         (owner: Keerthana)
#    Primary: Copernicus Marine (CMEMS). Use GLORYS multiyear for historical
#    dates -- the analysis/forecast product has NO historical coverage, and a
#    2017 request to it returns "no data" that looks exactly like an outage.
#    Sign up: https://marine.copernicus.eu  ->  register (free)
#    Also:    pip install copernicusmarine   (the library is not installed yet)
#    Fallback: HYCOM via OPeNDAP -- no key required.
# ---------------------------------------------------------------------------
CMEMS_USERNAME=
CMEMS_PASSWORD=

# ---------------------------------------------------------------------------
# 3. Wind                                                   (owner: Keerthana)
#    Primary: ERA5 via the NEW CDS. Two steps, and the second is the one
#    everyone forgets:
#      a) https://cds.climate.copernicus.eu -> register -> copy your personal
#         access token
#      b) OPEN THE ERA5 DATASET PAGE AND ACCEPT ITS LICENCE. Until you do,
#         cdsapi fails with an error that reads like a server fault.
#    Also: pip install cdsapi   (not installed yet)
#    Fallback: Open-Meteo -- no key, already working and in use.
# ---------------------------------------------------------------------------
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# ---------------------------------------------------------------------------
# 5. AIS                                                      (owner: Krishnan)
#    Danish DMA and MarineCadastre are open bulk downloads -- no key.
#    AISStream is optional, only for the live demo tab.
#    Sign up: https://aisstream.io  ->  free API key
# ---------------------------------------------------------------------------
AISSTREAM_API_KEY=

# ---------------------------------------------------------------------------
# 6. Basemap tiles                                              (owner: Indhu)
#    OpenStreetMap raster tiles need no key. Tiles for the demo bounding boxes
#    are pre-downloaded so the demo works with no network at all.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATA_ROOT=./data
HEALTH_ENABLED=true
HEALTH_INTERVAL=60
