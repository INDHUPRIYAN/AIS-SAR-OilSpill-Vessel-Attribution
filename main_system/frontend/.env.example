# Map providers. All optional: without them the globe draws the bundled
# Natural Earth basemap and reports imagery as "not configured".
# Documented in docs/ux/MAP_DATA_SOURCES.md.

# Satellite imagery: raster tile template ({z}/{x}/{y} or {z}/{y}/{x}).
VITE_MAP_SATELLITE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_MAP_SATELLITE_ATTRIBUTION=Imagery © Esri, Maxar, Earthstar Geographics
VITE_MAP_SATELLITE_MAXZOOM=17

# Optional raster detail under the labels at zoom >= 7 (a provider you have rights to use).
# VITE_MAP_DETAIL_URL=
# VITE_MAP_DETAIL_ATTRIBUTION=
