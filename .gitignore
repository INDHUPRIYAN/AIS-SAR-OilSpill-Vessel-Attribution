# [PROMPT-00b] Docs: keep authoritative specs + build dependencies, drop evidence bulk.
docs/qa/
docs/video/
docs/audit/*.png
Road-to-Production/*.png

# Superseded archive — kept on disk for reference, never a requirements source.
Old-files-and-some-audit-report/

# Database backups taken before migrations. Kept on disk as a local safety
# net; never committed -- they contain live operational data and are large.
*.bak

# Screening scratch: the detector's own mask rasters. The JSON responses beside
# them are the evidence and are tracked; the rasters are megabytes of binary
# regenerated by the commands in dev_evidence/P12b/README.md.
dev_evidence/**/_detect_scratch/**/*.tif

